# Optional. Compose already has every default below baked in as ${VAR:-default};
# copy this to .env only if you want to override something.

# MYSQL_DATABASE=squanchy_kitchens
# MYSQL_USER=squanchy
# MYSQL_PASSWORD=squanchy
# MYSQL_ROOT_PASSWORD=squanchy-root
#   MySQL is only reachable on the Compose network (3306 is not published), so these
#   defaults never leave the machine. Set your own for any real deployment; changing them
#   after the mysql-data volume exists needs `make reset-db`.

# APP_ENV=production
# APP_TIMEZONE=Asia/Jerusalem
# DATABASE_URL=mysql+pymysql://squanchy:squanchy@mysql:3306/squanchy_kitchens?charset=utf8mb4
# TEST_DATABASE_URL=mysql+pymysql://root:squanchy-root@mysql:3306/squanchy_kitchens_test?charset=utf8mb4

# Alert rules (the golden test pins these defaults)
# ALERT_THRESHOLD_C=5.0
# SAMPLE_INTERVAL_MINUTES=15
# MIN_EXCURSION_READINGS=2

# Seeding
# SEED_ON_STARTUP=true
# SEED_DEMO_DATA=true

# Uploads
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_MB=5

# Sign-in. Nothing secret is committed. Leave these empty and first start generates random
# passwords (shown once in `docker compose logs api`) and a JWT secret kept in a volume.
# To choose them yourself, copy this file to .env (never commit .env) and fill them in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Summer Smith
DEMO_MANAGER_PASSWORD=
# JWT_SECRET=        # optional: e.g. the output of `openssl rand -base64 48`
# JWT_EXPIRE_MINUTES=480
