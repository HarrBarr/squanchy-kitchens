# Optional. Compose already has every default below baked in as ${VAR:-default};
# copy this to .env only if you want to override something.

# MYSQL_DATABASE=squanchy_kitchens
# MYSQL_USER=squanchy
# MYSQL_PASSWORD=squanchy
# MYSQL_ROOT_PASSWORD=squanchy-root
#   (changing credentials after the mysql-data volume exists needs `make reset-db`)

# APP_ENV=production
# APP_TIMEZONE=Asia/Jerusalem
# DATABASE_URL=mysql+pymysql://squanchy:squanchy@mysql:3306/squanchy_kitchens?charset=utf8mb4
# TEST_DATABASE_URL=mysql+pymysql://root:squanchy-root@mysql:3306/squanchy_kitchens_test?charset=utf8mb4

# Alert rules (the golden test pins these defaults)
# ALERT_THRESHOLD_C=5.0
# SAMPLE_INTERVAL_MINUTES=15
# MIN_EXCURSION_READINGS=2

# Seeding
# SEED_ON_STARTUP=true
# SEED_DEMO_DATA=true

# Uploads
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_MB=5
